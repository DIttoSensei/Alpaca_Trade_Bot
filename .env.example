# Copy to .env and fill in. NEVER commit the real .env to git.

# --- Alpaca credentials ---
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
# Paper endpoint (default):
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live endpoint (only when TRADING_MODE=live and confirmation is set):
# ALPACA_BASE_URL=https://api.alpaca.markets

# --- Trading mode ---
# One of: backtest | shadow | paper | live
TRADING_MODE=paper

# Double-lock required to run LIVE. Must be exactly "true" (case-insensitive)
# in addition to TRADING_MODE=live, otherwise the bot refuses to start.
LIVE_TRADING_CONFIRMED=false

# --- Safety ---
# If this file exists in the project root, no new orders are placed.
KILL_SWITCH_FILE=KILL_SWITCH

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paths (optional overrides) ---
DATA_DIR=data
LOG_DIR=logs
REPORT_DIR=reports
DB_PATH=data/bot.db
